{
  "dependencies": {
    "@openzeppelin/contracts": "5.6.1"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-ethers": "4.0.15",
    "ethers": "6.17.0",
    "hardhat": "3.14.0",
    "prettier": "^3.9.6",
    "prettier-plugin-solidity": "^2.4.1"
  },
  "type": "module",
  "scripts": {
    "compile": "hardhat compile",
    "format": "prettier --plugin=prettier-plugin-solidity --write \"contracts/**/*.sol\"",
    "format:check": "prettier --plugin=prettier-plugin-solidity --check \"contracts/**/*.sol\""
  }
}
